# Copy to .env (`mise run setup` does it for you). .env is gitignored.
#
# Only Docker reads this file. Compose injects it into the containers, so in
# development you must run the app with `mise run dev`. Running
# `./gradlew bootRun` or `pnpm dev` directly on your machine will not load these
# values, and the app will fail on startup.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Host port for connecting a database GUI to the dev db.
POSTGRES_PORT=5432
