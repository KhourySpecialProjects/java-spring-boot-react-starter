# Docker Compose reads these and passes them into the containers.
SERVICE_USER_POSTGRES=app
SERVICE_PASSWORD_POSTGRES=app
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by commands that run on your machine, like db:dev:migrate:up. The backend
# container gets its own URL from compose.yaml.
DATABASE_URL=jdbc:postgresql://localhost:5432/app?user=app&password=app
LOG_LEVEL=info
